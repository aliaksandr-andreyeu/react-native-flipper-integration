{
  "name": "react-native-flipper-kit",
  "version": "1.0.0",
  "description": "Configurable Flipper integration for React Native (Old + New Architecture)",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "ReactNativeFlipperKit.podspec",
    "react-native.config.js",
    "app.plugin.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": {
    "name": "Cycleport",
    "url": "https://cycleport.com"
  },
  "contributors": [
    {
      "name": "Aliaksandr Andreyeu",
      "email": "andreyeu.aliaksandr@gmail.com"
    }
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react-native",
    "flipper",
    "debug",
    "turbo-module",
    "devtools"
  ],
  "bugs": {
    "url": "https://github.com/cycleport/react-native-flipper-kit/issues"
  },
  "homepage": "https://cycleport.com",
  "scripts": {
    "prepare": "npm run build && (husky || true)",
    "precommit": "lint-staged",
    "prepublishOnly": "npm run build",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"./**/*.{js,jsx,cjs,mjs,ts,tsx,json}\"",
    "format:check": "prettier --check \"./**/*.{js,jsx,cjs,mjs,ts,tsx,json}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "example": "npm --prefix examples/bare-new-arch start",
    "example:android": "npm --prefix examples/bare-new-arch run android",
    "example:ios": "npm --prefix examples/bare-new-arch run ios",
    "example:android:build": "npm --prefix examples/bare-new-arch run android:build",
    "example:e2e": "npm --prefix examples/bare-new-arch run e2e"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cycleport/react-native-flipper-kit.git"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "^10.0.0",
    "@react-native/babel-preset": "0.87.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.0.0",
    "babel-jest": "^30.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.0",
    "jest": "^30.5.1",
    "lint-staged": "^16.2.0",
    "lockfile-lint": "5.0.1",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.68.0"
  },
  "codegenConfig": {
    "name": "RNFlipperKitSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "dev.cycleport.flipperkit"
    },
    "ios": {
      "modulesProvider": {
        "ReactNativeFlipperKit": "ReactNativeFlipperKit"
      }
    }
  },
  "expo": {
    "name": "react-native-flipper-kit",
    "plugins": [
      "./app.plugin.js"
    ]
  }
}
