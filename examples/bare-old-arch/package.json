{
  "name": "flipper-integration-example-bare-old-arch",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "watchman:del:all": "watchman watch-del-all",
    "android:clean:build": "rm -rf ./android/build ./android/app/.cxx ./android/app/build",
    "android:clean": "npm run android:clean:build && cd android && ./gradlew --stop && ./gradlew clean",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "npm run watchman:del:all && react-native start",
    "start:reset": "npm run watchman:del:all && react-native start --reset-cache",
    "lint": "eslint .",
    "test": "jest",
    "android:build": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=x86_64",
    "ios:pod-install": "cd ios && pod install"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^11.4.7",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-default-preference": "^1.4.4",
    "react-native-flipper-kit": "file:../.."
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.9",
    "@react-native/eslint-config": "0.76.9",
    "@react-native/metro-config": "0.76.9",
    "@react-native/typescript-config": "0.76.9",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
