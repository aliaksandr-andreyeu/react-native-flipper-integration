{
  "name": "expo-old-arch",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "watchman:del:all": "watchman watch-del-all",
    "start": "npm run watchman:del:all && EXPO_PUBLIC_USE_RN_FETCH=1 expo start",
    "start:clear": "npm run watchman:del:all && EXPO_PUBLIC_USE_RN_FETCH=1 expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "EXPO_PUBLIC_USE_RN_FETCH=1 expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:android:clean": "expo prebuild --platform android --clean",
    "ios": "EXPO_PUBLIC_USE_RN_FETCH=1 expo run:ios",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:ios:clean": "expo prebuild --platform ios --clean",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@op-engineering/op-sqlite": "^17.1.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.8",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.11",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-default-preference": "^1.4.4",
    "react-native-flipper-kit": "file:../..",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
